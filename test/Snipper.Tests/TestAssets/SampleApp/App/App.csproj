<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CoreLib\CoreLib.csproj" />
    <ProjectReference Include="..\OrphanLib\OrphanLib.csproj" />
    <PackageReference Include="Humanizer.Core" Version="2.14.1" />
    <!-- Serilog.Sinks.Console requires Serilog >= 4.0.0: the direct Serilog reference
         is transitively supplied at the same version → SNP0012 target. Both are used
         in Worker.cs so SNP0003 stays silent. -->
    <PackageReference Include="Serilog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <!-- Load-bearing transitive subtree: nothing from Microsoft.Extensions.Logging.Console's
         own assembly is used, but its exclusive subtree (Logging.Abstractions) is — Worker.cs
         declares an ILogger. Removing the direct reference would evict the abstractions
         package and break compilation → SNP0003 must stay silent. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>
</Project>
