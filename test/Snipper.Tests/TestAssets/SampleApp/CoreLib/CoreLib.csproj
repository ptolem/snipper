<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Linked source outside every project directory: exercises the external-document exclusion. -->
    <Compile Include="..\Shared\SharedCode.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Inbox on net10.0 (override version >= 8.0.5): SNP0013 target. Used by JsonRoundTrip. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Unused in CoreLib, but consumer App uses Serilog: transitive consumer
         flow keeps the reference load-bearing - SNP0003 must stay silent. -->
    <PackageReference Include="Serilog" Version="4.0.0" />
    <!-- Same shape, but PrivateAssets=all blocks the transitive flow: consumer
         usage must NOT save this one - SNP0003 target. -->
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
