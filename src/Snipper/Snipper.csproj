<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

    <!-- Runtime configuration.
         TieredPGO is disabled deliberately. Snipper is a short-lived CLI that spends its
         life inside Roslyn/MSBuild code repeating the same call patterns thousands of times,
         so the instrumented tier-1 recompile and its PGO bookkeeping cost more than the
         optimised code saves.

         Measured with an INTERLEAVED A/B (DOTNET_TieredPGO=1 vs unset, alternating runs so
         machine drift cancels) over six targets, 4 reps each, on a 16-core box:

             target                wall              cpu
             Snipper.csproj    7.14 -> 6.74s  23.8 -> 19.7s   -5.5% / -17.3%
             Cscli.sln         8.91 -> 8.31s  21.5 -> 18.1s   -6.8% / -16.1%
             Peckr.sln         5.15 -> 5.00s   8.7 ->  7.7s   -2.9% / -11.6%
             AzureBusDepot.sln 4.32 -> 4.09s   8.6 ->  7.4s   -5.4% / -14.3%
             Cardano.sln      10.79 -> 9.60s  46.0 -> 37.5s  -11.1% / -18.6%
             Mintsafe.sln     10.10 -> 9.40s  19.0 -> 16.2s   -7.0% / -15.0%

         Every target improves on both axes; CPU falls further and more consistently than
         wall clock, which is the signature of less work rather than rescheduling. Non-
         interleaved measurement put one target 3.8% the other way, so treat single-sample
         deltas under ~5% wall as noise on this box.

         Re-enable with DOTNET_TieredPGO=1 if a future workload regresses. TieredCompilation
         itself stays ON: disabling it costs 27% on a run this short.

         Server GC is ENABLED. An earlier measurement on small targets (Cscli 7.91 -> 8.79s)
         rejected it because startup dominated; on a large solution the fan-out is GC-bound
         instead. Under workstation GC, MILKRUN's SNP0005/6 reference searches spent 34-41%
         of their wall time in gen0 pauses (~3,100 collections) and the process used ~7.5 of
         16 logical cores. Server GC (with .NET 10's DATAS sizing) measured, alternating:

             target              analysis        wall           peak WS   GC pause share
             MILKRUN (full)    ~93 -> ~58.5s   ~112 -> ~77s     ~2.6GB      41% -> 5%
             Snipper.slnx      6.8 -> 5.7s     8.9 -> 7.7s    +~120MB

         Reports are byte-identical. Revert with DOTNET_gcServer=0 if a memory-constrained
         host needs it. See docs/code_architecture.md. -->
    <PropertyGroup>
      <TieredPGO>false</TieredPGO>
      <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

  <!-- .NET global tool packaging -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>snipper</ToolCommandName>
    <PackageId>Snipper</PackageId>
    <Version>1.15.0</Version>
    <Authors>Snipper Contributors</Authors>
    <Description>Roslyn-based dead-code and unreferenced-dependency analyser for .NET solutions. Flags unused members, unreachable code, unreferenced packages/project references, and stale appsettings keys with certainty-tiered findings, JSON/SARIF reports, and CI baselines.</Description>
    <PackageTags>roslyn;static-analysis;dead-code;cleanup;msbuild;monorepo</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snipper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <!-- Direct reference is load-bearing: it transitively supplies Microsoft.CodeAnalysis.CSharp
         (syntax APIs used throughout Analysis/). Do not remove on SNP0003's earlier advice. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="NuGet.ProjectModel" Version="7.9.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <!-- Security pin, not a used dependency: NuGet.ProjectModel 7.9.0 reaches 8.0.1 through
         NuGet.Packaging, which is affected by GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7.
         Drop this once a NuGet.ProjectModel release resolves a patched version on its own. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
